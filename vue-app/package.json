{
  "name": "foldmemo-kodbox-ui",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:kodbox": "vue-tsc --noEmit && vite build --config vite.kodbox.config.ts",
    "build": "npm run build:kodbox",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --no-warnings --experimental-strip-types tests.mjs && node scripts/check-html-embed.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test:proxy": "node --no-warnings --experimental-strip-types scripts/proxy-regression.mjs",
    "test:theme": "node scripts/theme-regression.mjs",
    "test:note-category": "node --no-warnings --experimental-strip-types scripts/note-category-regression.mjs",
    "test:write-gate": "node scripts/write-gate-regression.mjs",
    "test:kodbox": "node ../plugins/foldMemo/test-bridge.cjs",
    "test:kodbox-php": "php ../plugins/foldMemo/test-server.php"
  },
  "dependencies": {
    "vue": "^3.5.0",
    "reka-ui": "^2.0.0",
    "lucide-vue-next": "^0.468.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.0",
    "@radix-icons/vue": "1.0.0",
    "@vueuse/core": "15.0.0",
    "cn": "0.4.0"
  },
  "devDependencies": {
    "vite": "^7.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "vite-plugin-singlefile": "^2.2.0",
    "typescript": "^5.8.0",
    "vue-tsc": "^3.0.0",
    "@types/node": "^22.0.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "tw-animate-css": "^1.2.0",
    "shadcn-vue": "^2.0.0"
  }
}
